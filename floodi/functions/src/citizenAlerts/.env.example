# Merge these NONSECRET settings into functions/.env.<existing-project-id>.
# This nested example is documentation, not a dotenv file loaded by Firebase.
# Keep delivery OFF while the provider/sender and release are being prepared.
CITIZEN_ALERT_DELIVERY_ENABLED=false
CITIZEN_ALERT_PROVIDER=resend
# Plain address on a domain that you own and have verified in Resend.
CITIZEN_ALERT_FROM_EMAIL=
# HTTPS site origin, without a path/query/fragment, for unsubscribe confirmation.
CITIZEN_ALERT_PUBLIC_URL=

# Never put CITIZEN_ALERT_RESEND_API_KEY here, in a VITE_ variable, or in source.
# Provision it interactively in the EXISTING project's Secret Manager:
# firebase functions:secrets:set CITIZEN_ALERT_RESEND_API_KEY --project <existing-project-id>
