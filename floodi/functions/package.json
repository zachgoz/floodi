{
  "name": "floodcast-functions",
  "description": "Firebase Cloud Functions for FloodCast",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test:rules": "firebase emulators:exec --only firestore --project demo-floodcast-rules --config ../firebase.rules-test.json \"node --test test/firestore.rules.test.cjs\"",
    "evaluate:residual": "npm run build && node lib/scripts/evaluate_residual.js",
    "collect:regional": "npm run build && node lib/scripts/collect_regional_history.js",
    "evaluate:weather-response": "npm run build && node lib/scripts/evaluate_weather_response.js",
    "evaluate:patterns": "npm run build && node lib/scripts/evaluate_patterns.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.1",
    "google-auth-library": "^10.9.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node-fetch": "^2.6.11",
    "typescript": "^5.4.0"
  },
  "private": true
}
