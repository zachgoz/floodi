# Existing Google Cloud project with Vertex enabled. Independent of Firebase storage.
# When omitted, use the project resolved by Application Default Credentials.
VERTEX_AI_PROJECT=

# TimesFM BigQuery configuration is independent of the Gemini/Vertex project.
# Pin the intended query project in the production project dotenv.
TIMESFM_BIGQUERY_PROJECT=
TIMESFM_BIGQUERY_LOCATION=us-central1

# Optional TimesFM-only identity. Production uses short-lived impersonation
# credentials; its runtime account needs getAccessToken on this target account.
# A matching local service-account key uses its existing identity directly.
TIMESFM_SERVICE_ACCOUNT_EMAIL=

# Local use only: set GOOGLE_APPLICATION_CREDENTIALS in .env.local or the shell.
# GOOGLE_APPLICATION_CREDENTIALS=../service-account.json
# Production uses runtime ADC/workload identity; do not deploy a private key file.
