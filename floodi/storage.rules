rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read-only access for archived webcam imagery written by trusted Admin SDK jobs.
    match /imagery/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other storage paths by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
